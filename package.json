{
  "name": "offline-parse",
  "version": "0.1.0",
  "private": true,
  "description": "Offline event registration: captive Wi-Fi form, local lead store, LCQ runner",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/main.js",
    "try": "node src/main.js --ip 127.0.0.1 --dns-port 5300 --db data/try/leads.db",
    "try:check": "node scripts/try-check.js",
    "qr": "node scripts/make-qr.js",
    "qr:show": "node scripts/make-qr.js --terminal",
    "booth-ip": "node scripts/booth-ip.js",
    "booth-ip:undo": "node scripts/booth-ip.js --undo",
    "test": "node --test"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
